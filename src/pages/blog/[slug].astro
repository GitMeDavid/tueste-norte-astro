
---
import { obtenerRecetaPorSlug } from "../../lib/wp";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { slug } = Astro.params;

const receta = await obtenerRecetaPorSlug(slug ?? "");

if (!receta) {
  Astro.response.status = 404;
}
---



<BaseLayout titulo={`${receta?.titulo ?? "Receta no encontrada"} | Tueste Norte`}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="contenido-blog">
      {
        receta ? (
          <>
            <h1>{receta.titulo}</h1>

            <p>
              Publicada el{" "}
              {new Date(receta.fecha).toLocaleDateString("es-ES")}
            </p>

            <Fragment set:html={receta.contenido} />
          </>
        ) : (
          <h1>Receta no encontrada</h1>
        )
      }
    </div>
  </article>
</BaseLayout>


<style>
    .contenido-blog :global(h1) {
        font-size: 2.25rem;
        font-weight: 700;
        color: #451a03;
        margin-bottom: 1rem;
    }

    .contenido-blog :global(h2) {
        font-size: 1.5rem;
        font-weight: 700;
        color: #451a03;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .contenido-blog :global(p) {
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .contenido-blog :global(ul) {
        list-style-type: disc;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }
</style>
