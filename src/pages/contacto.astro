---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout titulo="Contacto | Tueste Norte">
    <section class="mx-auto max-w-6xl px-4 py-12">
        <h1 class="mb-4 text-4xl font-bold text-amber-950">Contacto</h1>

        <p class="mb-8 text-lg text-gray-700">
            ¿Tienes alguna pregunta? Ponte en contacto con nosotros o visítanos
            en nuestra tienda.
        </p>
        <div class="max-w-2xl rounded-lg bg-amber-50 p-6">
            <h2 class="mb-4 text-2xl font-bold text-amber-950">
                Nuestra tienda
            </h2>

            <p class="mb-2 text-gray-700">
                <strong>Dirección:</strong> Calle del Café, 12 - Jaén
            </p>

            <p class="mb-2 text-gray-700">
                <strong>Teléfono:</strong> 953 000 000
            </p>

            <p class="mb-2 text-gray-700">
                <strong>Email:</strong> hola@tuestenorte.es
            </p>

            <p class="text-gray-700">
                <strong>Horario:</strong> Lunes a sábado, de 9:00 a 14:00 y de 17:00
                a 20:00
            </p>
        </div>
    </section>
</BaseLayout>
