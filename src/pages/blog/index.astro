---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { obtenerRecetas } from "../../lib/wp";

const posts = await obtenerRecetas();

posts.sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime());
---

<BaseLayout titulo="Blog | Tueste Norte">
    <section class="mx-auto max-w-6xl px-4 py-12">
        <h1 class="mb-4 text-4xl font-bold text-amber-950">Blog</h1>

        <p class="mb-8 text-lg text-gray-700">
            Recetas y métodos de preparación para disfrutar del mejor café en
            casa.
        </p>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
                posts.map((post) => (
                    <article class="rounded-lg bg-amber-50 p-6">
                        {post.imagen && (
                            <img
                                src={post.imagen}
                                alt={`Fotografía de ${post.titulo}`}
                                class="mb-4 h-48 w-full rounded-lg object-cover"
                            />
                        )}

                        <h2 class="mb-3 text-2xl font-bold text-amber-950">
                            <a
                                href={`/blog/${post.slug}`}
                                class="hover:underline"
                            >
                                {post.titulo}
                            </a>
                        </h2>

                        <p class="mb-3 text-gray-600">
                            {new Date(post.fecha).toLocaleDateString("es-ES")}
                        </p>

                        <Fragment set:html={post.descripcion} />
                    </article>
                ))
            }
        </div>
    </section>
</BaseLayout>
